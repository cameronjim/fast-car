# Not in git: rosbags, checkpoints, and other run data (see claude-docs/10-conventions.md).
data/

# Generated bindings — CI regenerates these from config/vehicle_params.yaml; never commit
# generated code (see claude-docs/10-conventions.md, claude-docs/06-vehicle-params.md).
**/generated/
*_generated.py
*_generated.hpp
*_generated.cpp

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*

# Bench session records written by racer_bench.engine.write_session_record
# (roadmap task 0.9) are run output, not curated fixtures -- same rule as
# data/ above (claude-docs/10-conventions.md). Real session notes belong in
# docs/notes/ once written up.
tests/bench/sessions/

# colcon build artifacts
ros_ws/build/
ros_ws/install/
ros_ws/log/
sim/bridge/build/
sim/bridge/install/
sim/bridge/log/
# .github/scripts/e2e_sim_safety_test.sh (and similarly-shaped combined-workspace scripts)
# run `colcon test` from the repo root with no --log-base override, so colcon's own default
# ./log lands at the repo root when that script is run locally (bind-mounted, unlike CI's
# ephemeral runner workspace) -- found while verifying milestone 3 locally.
/log/

# Core dumps. A 155 MB `core` file was once committed under ros_ws/src/racer_tools by an
# agent running a crashing test locally (ulimit -c unlimited on that machine) and had to be
# removed by hand -- this rule is so that mistake cannot recur silently. Matches a file or
# directory named exactly `core`, or `core.<pid>`, anywhere in the tree; no directory named
# `core` exists in this repo today, so this is not expected to hide anything real.
core
core.[0-9]*

# macOS
.DS_Store

# other
.claude
/claude-docs
CLAUDE.md
# firmware/safety_mux Pico SDK build tree and the flashable .uf2 it produces. Build output,
# not source: regenerate with the command in firmware/safety_mux/README.md's "Building"
# section. Same rule as data/ and the generated bindings above.
firmware/safety_mux/build/
firmware/safety_mux/build-artifacts/
