# Not in git: rosbags, checkpoints, and other run data (see claude-docs/10-conventions.md).
data/

# Generated bindings — CI regenerates these from config/vehicle_params.yaml; never commit
# generated code (see claude-docs/10-conventions.md, claude-docs/06-vehicle-params.md).
**/generated/
*_generated.py
*_generated.hpp
*_generated.cpp

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*

# Bench session records written by racer_bench.engine.write_session_record
# (roadmap task 0.9) are run output, not curated fixtures -- same rule as
# data/ above (claude-docs/10-conventions.md). Real session notes belong in
# docs/notes/ once written up.
tests/bench/sessions/

# colcon build artifacts
ros_ws/build/
ros_ws/install/
ros_ws/log/
sim/bridge/build/
sim/bridge/install/
sim/bridge/log/
# .github/scripts/e2e_sim_safety_test.sh (and similarly-shaped combined-workspace scripts)
# run `colcon test` from the repo root with no --log-base override, so colcon's own default
# ./log lands at the repo root when that script is run locally (bind-mounted, unlike CI's
# ephemeral runner workspace) -- found while verifying milestone 3 locally.
/log/

# macOS
.DS_Store
