<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racer_track_perception</name>
  <version>0.1.0</version>
  <description>
    Plug-and-play part A: LiDAR scan to a local track (centreline, free width each side,
    uncertainty) in the car frame. Two backends behind one node and one message: a numpy
    forward pass of a small net trained in simulation, and a classical geometric corridor
    tracer. Publishes /pnp/local_track only; never /drive_raw or /drive.
  </description>
  <maintainer email="64621038+cameronjim@users.noreply.github.com">cameronjim</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>racer_pnp_msgs</depend>
  <depend>racer_tools</depend>
  <depend>python3-yaml</depend>
  <depend>python3-jsonschema</depend>
  <depend>python3-numpy</depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
