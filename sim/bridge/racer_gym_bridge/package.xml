<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>racer_gym_bridge</name>
  <version>0.1.0</version>
  <description>
    ROS 2 Humble bridge between the pinned f1tenth_gym simulator and the
    racer topics (roadmap task 0.5, claude-docs/04-architecture.md):
    publishes /scan and /sim/ground_truth_odom, subscribes to /drive, and
    steps the sim at a fixed rate. See sim/README.md and
    claude-docs/07-sim-and-sysid.md.
  </description>
  <maintainer email="64621038+cameronjim@users.noreply.github.com">cameronjim</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
