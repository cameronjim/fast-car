<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>l5_pnp_laps</name>
  <version>0.1.0</version>
  <description>
    L5 canary for lap learning (tests/l5_pnp_laps): the Plug-and-Play driver plus racer_laps'
    lap_memory_node (start-scan lap source, no map) laps the tuning stadium through the real
    command path; the system's lap count and lap times are scored against the simulator's ground
    truth. Also holds the lap learning sim battery of the pre-registration (battery.py,
    lap_battery.py). Uses tests/l5_reactive_bench/track_family_runner.py (driver pnp).
  </description>
  <maintainer email="64621038+cameronjim@users.noreply.github.com">cameronjim</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>racer_gym_bridge</exec_depend>
  <exec_depend>racer_track_perception</exec_depend>
  <exec_depend>racer_planner</exec_depend>
  <exec_depend>racer_laps</exec_depend>
  <exec_depend>racer_pnp_msgs</exec_depend>
  <exec_depend>racer_safety</exec_depend>
  <exec_depend>racer_msgs</exec_depend>
  <exec_depend>racer_tools</exec_depend>
  <exec_depend>racer_bringup</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
