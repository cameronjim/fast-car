<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>l5_pnp_oracle</name>
  <version>0.1.0</version>
  <description>
    TEST ONLY (brief 40, measurement M-A2): an oracle track node that publishes a ground truth
    racer_pnp_msgs/LocalTrack from the simulator in place of track_perception_node, its pure
    core, and the tests: L1 geometry, the guard that the car's launch cannot start it, stamp and
    timing parity with the perception node, and an L5 canary on the obstacle development case.
    Never installed; track_family_runner.py runs the node by path.
  </description>
  <maintainer email="64621038+cameronjim@users.noreply.github.com">cameronjim</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>racer_gym_bridge</exec_depend>
  <exec_depend>racer_track_perception</exec_depend>
  <exec_depend>racer_planner</exec_depend>
  <exec_depend>racer_laps</exec_depend>
  <exec_depend>racer_pnp_msgs</exec_depend>
  <exec_depend>racer_safety</exec_depend>
  <exec_depend>racer_msgs</exec_depend>
  <exec_depend>racer_tools</exec_depend>
  <exec_depend>racer_bringup</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
