[Unit]
Description=Racer layer-1 safety mux heartbeat (Jetson-side GPIO toggle)
Documentation=file:///opt/racer/jetson_heartbeat/README.md
# Deliberately NOT After=network.target or any ROS/DDS unit: per
# firmware/safety_mux/pico/heartbeat_input.h, this heartbeat's entire value is that it does
# NOT depend on the network stack, ROS, or the desktop session being up. It should start as
# early as the kernel has brought up the GPIO controller.
DefaultDependencies=no
After=sysinit.target
Wants=sysinit.target
# DefaultDependencies=no also drops the implicit shutdown ordering every normal unit gets, so
# it is put back explicitly. Without these two lines the heartbeat is not stopped as part of
# the shutdown transition and is killed at an arbitrary later point, which looks from the mux
# side exactly like a Jetson that died -- true, eventually, but it should be a clean stop.
Conflicts=shutdown.target
Before=shutdown.target
# No start rate limiting. systemd's default (5 starts in 10 s, then the unit is left in a
# failed state and STOPS being restarted) turns a persistent failure into a permanent one:
# the line being held by another process, or a chip renumbered by a JetPack update, would
# have the heartbeat give up after ~5 seconds and never try again. The mux fails safe either
# way -- no edges is a cut -- but a watchdog signal that has permanently stopped retrying is
# not something to discover at the bench. With RestartSec=1 this retries once a second for as
# long as the machine is up, and `systemctl status` still shows every failure.
StartLimitIntervalSec=0

[Service]
Type=simple
# These three Environment= lines are the actual fallback: they must match
# include/jetson_heartbeat/config.h's JETSON_HEARTBEAT_DEFAULT_* compiled-in defaults
# exactly (test_default_env_file_matches_compiled_defaults, tests/test_heartbeat_config.c,
# checks this file's Environment= lines against those constants). Without them, a missing or
# unreadable /etc/default/racer-heartbeat would NOT fall back to the binary's own defaults:
# EnvironmentFile=-... only makes the missing file non-fatal to systemd's unit-loading, it
# does not make the shell-style ${RACER_HB_CHIP} etc. substitutions in ExecStart below fall
# back to anything. With no Environment= line and no env file, each ${VAR} expands to the
# empty string, ExecStart becomes `racer-heartbeat --chip "" --line "" --rate-hz ""`, the
# binary exits 1 on the first bad argument, and Restart=always retries that same failure
# forever -- a missing config file would silently and permanently cut the mux. Putting the
# real defaults here first means EnvironmentFile= below can only ever override them, never
# leave a variable unset.
Environment=RACER_HB_CHIP=gpiochip0
Environment=RACER_HB_LINE=144
Environment=RACER_HB_RATE_HZ=50
# GPIO chip/line/rate are then overridden from /etc/default/racer-heartbeat when present, so
# the pin can be changed (e.g. once tools/jetson_pinmux/ settles which header pin is wired to
# the mux) with an edit + restart, never a rebuild or a unit-file edit. See
# tools/jetson_heartbeat/racer-heartbeat.default for the pin table and the required
# verification steps before trusting a change here. The leading "-" makes a missing file a
# non-event rather than a unit-load error; per the Environment= lines above, "missing" now
# means "use the compiled defaults", not "use empty strings".
EnvironmentFile=-/etc/default/racer-heartbeat
# Absolute path: this unit does not source a shell profile, so PATH is whatever systemd's
# own default is -- do not rely on it finding the binary by name. The three variables are
# substituted by systemd itself from EnvironmentFile above, not by a shell (Type=simple with
# no shell wrapper), so no quoting/globbing surprises apply.
ExecStart=/opt/racer/jetson_heartbeat/racer-heartbeat --chip ${RACER_HB_CHIP} --line ${RACER_HB_LINE} --rate-hz ${RACER_HB_RATE_HZ}
Restart=always
RestartSec=1
# A restart takes about a second, which is ten times the mux's 0.1 s watchdog window: a crash
# of this process IS a cut, by design. RestartSec is not tuned to hide that and must not be.
# GPIO character-device access on this board's default udev rules requires root (or a gpio
# group ACL this repo does not assume is set up); running as root also matches
# firmware/safety_mux/README.md's stance that nothing about this heartbeat is meant to be
# hardened against the Jetson's own root user -- the safety boundary is the separate MCU,
# not this process's privilege level.
User=root
# No stdin, minimal surface. stdout/stderr go to the journal (journalctl -u racer-heartbeat)
# per claude-docs/10-conventions.md's logging rules for tools/ scripts.
StandardOutput=journal
StandardError=journal
# Watchdog note: this unit itself has no systemd watchdog (WatchdogSec) configured. Its
# purpose IS the watchdog signal for the separate mux MCU; monitoring racer-heartbeat.service
# itself (e.g. via `systemctl is-active`, or a future rosbag-adjacent health check) is a
# separate concern from the GPIO-level signal the mux hardware actually watches.

[Install]
WantedBy=multi-user.target
