<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Advertises the racer app on the LAN. The host name racer-car.local itself comes from
     avahi-daemon publishing the Jetson's hostname. -->
<service-group>
  <name replace-wildcards="yes">Racer on %h</name>
  <service>
    <type>_racer._tcp</type>
    <port>@PORT@</port>
    <txt-record>path=/</txt-record>
  </service>
  <service>
    <type>_http._tcp</type>
    <port>@PORT@</port>
    <txt-record>path=/</txt-record>
  </service>
</service-group>
